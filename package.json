{
  "name": "satellite-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mission-control-styled satellite tracker: ~16k objects propagated live with SGP4 on a 3D globe, with pass prediction and an LLM assistant grounded in real orbital state.",
  "license": "MIT",
  "author": "Joshua Gillmore",
  "homepage": "https://sattracker-production.up.railway.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrangeAgente/Satellite-Tracker.git"
  },
  "bugs": {
    "url": "https://github.com/OrangeAgente/Satellite-Tracker/issues"
  },
  "keywords": [
    "satellite",
    "sgp4",
    "tle",
    "celestrak",
    "three.js",
    "orbital-mechanics",
    "space",
    "visualization"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:data": "node scripts/build-dataset.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satellite.js": "^5.0.0",
    "three": "^0.169.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
